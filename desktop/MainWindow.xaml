<Window x:Class="EasyDTO.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="EasyDTO"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />

        <Border x:Name="StatusOverlay" Background="#F21A1A1A">
            <StackPanel MaxWidth="680"
                        Margin="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="StatusTitle"
                           FontFamily="Segoe UI"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="Запуск EasyDTO…"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <ScrollViewer MaxHeight="320"
                              Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="StatusDetail"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               Foreground="#FFC8C8C8"
                               Text="Подготовка интерфейса."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </ScrollViewer>

                <ProgressBar x:Name="StartupProgress"
                             Width="280"
                             Height="4"
                             Margin="0,24,0,0"
                             IsIndeterminate="True" />

                <Button x:Name="RetryButton"
                        Width="160"
                        Height="36"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Background="#FF2F6FED"
                        BorderThickness="0"
                        Click="OnRetryClick"
                        Content="Повторить"
                        Cursor="Hand"
                        Foreground="White"
                        Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
